# ==========================================================
# DevLens Environment Configuration Template
# ==========================================================

# Application Metadata
APP_NAME=DevLens
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database Configuration
# SQLite local default:
DATABASE_URL=sqlite:///./devlens.db
# PostgreSQL production example:
# DATABASE_URL=postgresql://devlens_user:secret_password@localhost:5432/devlens_db

# Security & JWT Tokens
# Generate a secure 32+ character random secret in production (e.g. openssl rand -hex 32)
JWT_SECRET=devlens-development-insecure-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# CORS Whitelist (JSON array)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:80", "http://127.0.0.1:5173", "http://127.0.0.1:8000"]

# AI Model Provider
# Supported options: 'mock' (hermetic offline mock), 'gemini' (Google Gemini API)
AI_PROVIDER=mock

# Google Gemini API Key (Required only if AI_PROVIDER=gemini)
GEMINI_API_KEY=

# Input Size Limits
MAX_CODE_LENGTH_CHARS=50000
MAX_CODE_LINES=1500
